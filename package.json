{
  "name": "genai-learn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node --no-warnings scripts/gen-topic-index.mjs",
    "dev": "vite",
    "prebuild": "node --no-warnings scripts/gen-topic-index.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate": "node --no-warnings scripts/gen-topic-index.mjs --check && node --no-warnings scripts/validate-content.mjs && node --no-warnings scripts/validate-achievements.mjs && node --no-warnings --test tests/prompt-checks.test.ts",
    "test": "node --no-warnings --test 'tests/*.test.ts'",
    "test:prompts": "node --no-warnings --test tests/prompt-checks.test.ts",
    "project": "node --no-warnings scripts/run-project.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "canvas-confetti": "1.9.4",
    "cmdk": "1.1.1",
    "lucide-react": "1.49.0",
    "motion": "13.4.6",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-simple-code-editor": "^0.14.1",
    "remark-gfm": "^4.0.1",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^24.13.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
